# Environment variables for the LTI website.
# For local dev: copy to `.env.development` and fill in real values (gitignored).
# For production: set these in the hosting dashboard's environment variables.
# NEVER commit real secret values.

# Licence Manager trial webhook — the x-api-key secret (server-side only).
LICENCE_TRIAL_SECRET=your-licence-manager-api-key-here

# Optional: override the trial endpoint. Defaults to the http:// URL in the function.
# Switch this to the https:// URL once the licence manager has TLS enabled.
# LICENCE_TRIAL_URL=https://licence.manager.londontradinginstitute.londontradinggroup.com/trial
